{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "5Central Ops",
  "version": "1.0.0",
  "identifier": "com.5central.r-ops",
  "build": {
    "frontendDist": "../desktop/launch"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src https:; img-src data:"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Business",
    "shortDescription": "5Central Ops",
    "longDescription": "5Central Ops for Mac opens the 5Central Ops manager in its own window with a native menu bar, keyboard shortcuts and a connection check.",
    "copyright": "© 5Central Capital",
    "publisher": "5Central Capital",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": { "width": 540, "height": 340 },
        "appPosition": { "x": 140, "y": 160 },
        "applicationFolderPosition": { "x": 400, "y": 160 }
      }
    }
  }
}
